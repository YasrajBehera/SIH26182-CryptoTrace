# Backend
APP_NAME=CryptoTrace
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://cryptotrace:cryptotrace@localhost:5432/cryptotrace

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Blockchain APIs - NEVER commit real keys
# Ethereum live investigations use Alchemy's eth-mainnet API.
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Ronin (optional). Ronin investigations work without any key through the
# official public JSON-RPC, but that transport can only discover ERC-20/721/1155
# Transfer events inside a bounded, recent block window, so results are reported
# as LIVE_PARTIAL rather than as complete history.
#
# Measured against https://api.roninchain.com/rpc:
#   * eth_getLogs rejects any range wider than exactly 200 blocks, so a wider
#     window is walked in 200-block chunks, newest first.
#   * Ronin blocks average ~2s, so 200 blocks is only ~7 minutes of history.
#   * the endpoint throttles aggressively and answers a throttled eth_getLogs
#     with an EMPTY result rather than an error, so an empty scan is validated
#     against a positive control before NO_DATA is reported.
#   RONIN_RPC_ENABLED  set to false to disable the official RPC transport.
#   RONIN_RPC_URL      override the official endpoint (default below).
#   RONIN_SCAN_BLOCKS  discovery window in blocks (default 100000 ~= 2 days).
#   RONIN_MAX_REQUESTS  ceiling on eth_getLogs calls per investigation. The walk
#                      stops early once enough transfers are found, so this only
#                      bounds the worst case (default 180 ~= 60 chunks ~= 12000
#                      blocks of token history).
#   RONIN_NATIVE_SCAN_BLOCKS  window for native RON transfers, which emit no log
#                      and therefore cost one block fetch per block (default
#                      1000 ~= 33 minutes).
#   RONIN_RPC_CONCURRENCY  parallel in-flight calls. 4+ makes the public
#                      endpoint hang until the request timeout, so keep this at 2
#                      unless you point RONIN_RPC_URL at your own node.
#   RONIN_CHAIN_ID     expected EVM chain id; the provider refuses to serve data
#                      from an endpoint that reports anything else (default 2020).
RONIN_RPC_ENABLED=true
RONIN_RPC_URL=https://api.roninchain.com/rpc
RONIN_SCAN_BLOCKS=100000
RONIN_MAX_REQUESTS=180
RONIN_NATIVE_SCAN_BLOCKS=1000
RONIN_RPC_CONCURRENCY=2
RONIN_CHAIN_ID=2020

# Optional: an Alchemy key whose app has the RONIN_MAINNET network enabled.
# This is the only transport that can return full Ronin history; when it is not
# enabled the provider falls back to the official RPC and says so in the result.
RONIN_ALCHEMY_API_KEY=

# Security (required in production — generates a dev secret if blank)
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=120

# CORS (comma-separated origins; dev default covers localhost:5173/4173)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Demo seeding
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=

# SAHYOG (false unless a production I4C/NCRP API is configured)
SAHYOG_PRODUCTION_API_CONFIGURED=false
