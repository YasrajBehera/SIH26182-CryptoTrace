# Backend
APP_NAME=CryptoTrace
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://cryptotrace:cryptotrace@localhost:5432/cryptotrace

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Blockchain APIs - NEVER commit real keys
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Security (required in production — generates a dev secret if blank)
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=120

# CORS (comma-separated origins; dev default covers localhost:5173/4173)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Demo seeding
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=

# SAHYOG (false unless a production I4C/NCRP API is configured)
SAHYOG_PRODUCTION_API_CONFIGURED=false
